document.body.style.background = 'purple';

const colorMap = {
  Green: 'green',
  Blue: 'blue',
  Red: 'red',
  Purple: 'purple'
};

// Function to apply color
function applyColor(color) {
  document.body.style.background = color;
  localStorage.setItem('selectedColor', color);
}

// Load saved color on page load
function loadSavedColor() {
  const savedColor = localStorage.getItem('selectedColor');
  if (savedColor) {
    applyColor(savedColor);
  }
}

// Apply saved color when page loads
document.addEventListener('DOMContentLoaded', loadSavedColor);

// Add click listeners to color buttons
document.querySelectorAll('#Green, #Blue, #Red, #Purple').forEach((button) => {
  button.addEventListener('click', () => {
    const color = colorMap[button.id];
    applyColor(color);
  });
});

//to-do list
document.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('.to-do-form');
  const input = form.querySelector('input[type="text"]');
  const list = form.querySelector('.to-do-list');
  let todoId = 2; // Start at 2 since Sample task is todo1

  // Function to save tasks to localStorage
  function saveTasks() {
    const tasks = [];
    document.querySelectorAll('.to-do-item').forEach((item, index) => {
      const label = item.querySelector('label');
      const checkbox = item.querySelector('input[type="checkbox"]');
      tasks.push({
        id: index,
        text: label.textContent,
        completed: checkbox.checked
      });
    });
    localStorage.setItem('todoTasks', JSON.stringify(tasks));
  }

  // Function to load tasks from localStorage
  function loadTasks() {
    const savedTasks = localStorage.getItem('todoTasks');
    if (savedTasks) {
      const tasks = JSON.parse(savedTasks);
      tasks.forEach((task) => {
        createTaskElement(task.text, task.completed);
      });
    }
  }

  // Function to create a task element
  function createTaskElement(text, completed = false) {
    const item = document.createElement('li');
    item.classList.add('to-do-item');
    
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.id = `todo${todoId}`;
    checkbox.classList.add('todo-checkbox');
    checkbox.checked = completed;
    
    const label = document.createElement('label');
    label.htmlFor = `todo${todoId}`;
    label.textContent = text;
    
    const deleteBtn = document.createElement('button');
    deleteBtn.classList.add('delete-btn');
    deleteBtn.setAttribute('aria-label', 'Delete task');
    deleteBtn.textContent = '×';
    deleteBtn.type = 'button';
    
    deleteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      list.removeChild(item);
      saveTasks();
    });

    checkbox.addEventListener('change', saveTasks);
    
    item.appendChild(checkbox);
    item.appendChild(label);
    item.appendChild(deleteBtn);
    list.appendChild(item);
    todoId++;
  }

  // Load tasks on page load
  loadTasks();

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input.value.trim();
    if (value) {
      createTaskElement(value);
      saveTasks();
      input.value = '';
    }
  });
});

const form = document.querySelector('form');
const nameInput = document.getElementById('name');
const emailInput = document.getElementById('email');
const subjectInput = document.getElementById('subject');
const messageInput = document.getElementById('message');
const errorMessage = document.getElementById('error-message');

if (errorMessage) {
  errorMessage.style.display = 'none';
}

if (form) {
  form.setAttribute('novalidate', 'novalidate');

  form.addEventListener('submit', (event) => {
    const messages = [];

    if (nameInput.value.trim() === '') {
      messages.push('Name is required');
    }
    if (emailInput.value.trim() === '') {
      messages.push('Email is required');
    }
    if (subjectInput.value.trim() === '') {
      messages.push('Subject is required');
    }
    if (messageInput.value.trim() === '') {
      messages.push('Message is required');
    }

    if (messages.length > 0) {
      errorMessage.textContent = messages.join(', ');
      errorMessage.style.display = 'block';
      event.preventDefault();
      return;
    }

    errorMessage.textContent = '';
    errorMessage.style.display = 'none';
  });
}

//validation for contact form
function isValidEmail(email) {
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailPattern.test(email);
}

const contactForm = document.querySelector('.contact-form');

if (contactForm) {
  const nameInput = contactForm.querySelector('#name');
  const emailInput = contactForm.querySelector('#email');
  const subjectInput = contactForm.querySelector('#subject');
  const messageInput = contactForm.querySelector('#message');
  const errorMessage = contactForm.querySelector('#error-message');

  // Function to validate and display errors in real-time
  function validateForm() {
    const nameValue = nameInput.value.trim();
    const emailValue = emailInput.value.trim();
    const subjectValue = subjectInput.value.trim();
    const messageValue = messageInput.value.trim();

    const errorMessages = [];

    if (nameValue.length < 2) {
      errorMessages.push('Name must be at least 2 characters long.');
    }
    if (emailValue && !isValidEmail(emailValue)) {
      errorMessages.push('Please enter a valid email address.');
    }
    if (subjectValue.length < 5) {
      errorMessages.push('Subject must be at least 5 characters long.');
    }
    if (messageValue.length < 10) {
      errorMessages.push('Message must be at least 10 characters long.');
    }

    if (errorMessages.length > 0) {
      errorMessage.textContent = errorMessages.join(', ');
      errorMessage.style.display = 'block';
    } else {
      errorMessage.textContent = '';
      errorMessage.style.display = 'none';
    }
  }

  // Add real-time validation on input
  nameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);
  subjectInput.addEventListener('input', validateForm);
  messageInput.addEventListener('input', validateForm);

  // Validate on form submit
  contactForm.addEventListener('submit', (event) => {
    validateForm();
    if (errorMessage.textContent !== '') {
      event.preventDefault();
    }
  });
}

